PORT=3000

# ─── Redsys ───────────────────────────────────────────────────
# Se configura por tenant en Supabase (tabla tenants), NO aquí.
# Campos: redsys_merchant_code, redsys_merchant_terminal,
#         redsys_merchant_key, redsys_modo, pago_online_activo

# ─── Recordatorios ────────────────────────────────────────────
# Se activan por tenant en Supabase (recordatorios_activos = true)
# o desde el dashboard del cliente.
# El cron corre automáticamente cada día a las 18:00 (Europe/Madrid).
# Para forzar manualmente: POST /admin/recordatorios/forzar
