# ─── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJh...service_role...

# ─── URL pública del bot (Railway te la da al desplegar) ──────
